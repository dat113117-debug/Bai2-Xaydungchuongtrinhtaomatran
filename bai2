
#include <stdio.h>
#include <stdlib.h>

int main() {
    int h, c;
    printf("Nhap so hang va so cot: ");
    scanf("%d%d", &h, &c);
    int **ma = (int **)malloc(h * sizeof(int *));

    if (ma == NULL) {
        printf("Khong du bo nho!\n");
        return 1;
    }
    for (int i = 0; i < h; i++) {
        ma[i] = (int *)malloc(c * sizeof(int));

        if (ma[i] == NULL) {
            printf("Khong du bo nho!\n");
            for (int j = 0; j < i; j++) {
                free(ma[j]);
            }

            free(ma);
            return 1;
        }
    }
    printf("Nhap cac phan tu cua ma tran:\n");

    for (int i = 0; i < h; i++) {
        for (int j = 0; j < c; j++) {
            printf("ma[%d][%d] = ", i, j);
            scanf("%d", &ma[i][j]);
        }
    }
    printf("\nMa tran %dx%d vua tao:\n", h, c);

    for (int i = 0; i < h; i++) {
        for (int j = 0; j < c; j++) {
            printf("%d\t", ma[i][j]);
        }
        printf("\n");
    }
    for (int i = 0; i < h; i++) {
        free(ma[i]);
    }

    free(ma);

    return 0;
}
